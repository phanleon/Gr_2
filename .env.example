# Server Configuration
PORT=8080
NODE_ENV=production

# JWT Authentication Secret (Khuyến nghị thay đổi chuỗi bí mật ngẫu nhiên trong môi trường production)
JWT_SECRET=your_super_strong_random_jwt_secret_here

# (Tùy chọn) Cấu hình Cloudflare Tunnel cố định
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_CUSTOM_DOMAIN=

# (Tùy chọn) Cấu hình GitHub Gist Dynamic Discovery Registry
GIST_ID=
GITHUB_TOKEN=
